# GEMINI_API_KEY: Required for Gemini AI API calls on the secure backend.
# Never expose this key in the Android APK or browser bundle.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public HTTPS URL where this backend is hosted.
APP_URL="MY_APP_URL"

# SIFAT_CLIENT_TOKEN: Shared bearer secret for native Android app requests to /api/agent/*.
# In production, generate a high-entropy random secret or use Firebase/OIDC user tokens.
SIFAT_CLIENT_TOKEN="CHANGE_ME_BEFORE_PRODUCTION"
